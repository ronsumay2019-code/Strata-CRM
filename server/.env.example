STRATA_ENV=development
DATABASE_URL=sqlite:///./strata.db
STRATA_ADMIN_EMAIL=you@yourdomain.com
STRATA_ADMIN_PASSWORD=replace-with-at-least-14-random-characters
STRATA_ENCRYPTION_KEY=generate-with-python-cryptography-fernet
# Production HTTPS public origin (mandatory for Twilio webhook validation)
STRATA_PUBLIC_URL=https://crm.example.com
# ONLY set to true following verified carrier-approved A2P/10DLC campaign status.
STRATA_MESSAGING_APPROVED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
